# ===== TOPGPS（GPS/里程采集） =====
# GPS 接口凭证
GPS_API_URL=<https://example.com/api>
GPS_USER_ID=<user>
GPS_PASSWORD=<password>
# 轮询间隔（秒）与超时
GPS_INTERVAL=10
GPS_TIMEOUT=10
# 是否解析地址（0/1）
GPS_NEED_ADDRESS=0
# MongoDB（Atlas）
MONGO_URI=<mongodb+srv://user:pass@host/db>
MONGO_DB=TOPGPS
# 仅 gps_bucket_poller 使用（里程脚本固定写 vehicle_mileage，勿改）
MONGO_COLLECTION=vehicle_gps_buckets
# 分桶 flush 间隔（秒）与批量大小
BUCKET_FLUSH_INTERVAL=15
BUCKET_BATCH_SIZE=500
# 队列最大长度
QUEUE_MAX_SIZE=10000
# 指标端口
METRICS_PORT=9090

# ===== waybill-sync（运单同步） =====
WAYBILL_API_BASE=<https://example.com>
WAYBILL_USERNAME=<user>
WAYBILL_PASSWORD=<password>
# 企业微信
WECOM_CORP_ID=<corp_id>
WECOM_CORP_SECRET=<corp_secret>
WECOM_AGENT_ID=<agent_id>
# 智能表格
SMARTSHEET_DOC_URL=<doc_url>
SMARTSHEET_SHEET_ID=<sheet_id>
# 动态表格（DTJK）
DTJK_DOCID=<docid>
# token 提前刷新缓冲（秒）
TOKEN_BUFFER_SECONDS=300